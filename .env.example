# ==============================================================================
# AirWise AI — Environment Configuration Example
# ==============================================================================
# NOTE: Never commit sensitive keys or your actual .env file to version control.
# Copy this file to .env before starting the server.

# Server Port
PORT=3001

# Runtime Environment (development | test | production)
NODE_ENV=development

# Frontend Client Origin for Restricted CORS
CLIENT_ORIGIN=http://localhost:5173

# Environmental Data Provider
# Supported: "open-meteo" (Default, free, global, no API key required) | "demo" (deterministic offline mock)
AIR_QUALITY_PROVIDER=open-meteo

# Optional: API key if using an authenticated provider (not required for Open-Meteo)
AIR_QUALITY_API_KEY=

# Google Gemini API Configuration (Official Google GenAI SDK)
# Required for live GenAI synthesis. If left empty, AirWise AI runs in deterministic
# evidence-aware rule engine mode without failing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database Path (Optional, defaults to :memory: or local db file in storage)
DATABASE_PATH=./server/data/airwise.sqlite
